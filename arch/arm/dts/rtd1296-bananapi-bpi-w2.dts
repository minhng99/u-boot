/dts-v1/;

#include "rtd1296.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Banana Pi BPI-W2";
	compatible = "bananapi,bpi-w2", "realtek,rtd1296";

	aliases {
		serial0 = &uart0;
		spi0 = &sfc;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0 0x80000000>;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	regulator-fan {
		compatible = "regulator-fixed";
		regulator-name = "fan-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&gpio 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_pins>;
	};
};

&{/reserved-memory} {
	/delete-node/ rpc@1f000;
	/delete-node/ rpc@1ffe000;
	/delete-node/ tee@10100000;

	bl31@10000000 {
		reg = <0x10000000 0x40000>;
		no-map;
	};
};

&cpu0 { enable-method = "psci"; };
&cpu1 { enable-method = "psci"; };
&cpu2 { enable-method = "psci"; };
&cpu3 { enable-method = "psci"; };

&pinctrl {
	fan_pins: fan-pins {
		pinctrl-single,bits = <0xc 0 0x00030000>;
	};
};

&sfc {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;
	};
};

&uart0 {
	status = "okay";
};
