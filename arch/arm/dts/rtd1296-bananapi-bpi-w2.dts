/dts-v1/;

#include "rtd1296.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "Banana Pi BPI-W2";
	compatible = "bananapi,bpi-w2", "realtek,rtd1296";

	aliases {
		serial0 = &uart0;
		spi0 = &sfc;
		ethernet0 = &gmac;
		mmc0 = &emmc;
		mmc1 = &sd;
		pci0 = &pcie0;
		pci1 = &pcie1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";

		link_led: led-link {
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_LAN;
			gpios = <&iso_gpio 29 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		activity_led: led-activity {
			color = <LED_COLOR_ID_AMBER>;
			function = LED_FUNCTION_LAN;
			gpios = <&iso_gpio 31 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	memory@0 {
		device_type = "memory";
		reg = <0 0x80000000>;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	regulator-fan {
		compatible = "regulator-fixed";
		regulator-name = "fan-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&gpio 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_pins>;
	};

	sd_supply: regulator-sd {
		compatible = "regulator-fixed";
		regulator-name = "sd-3v3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpios = <&gpio 99 GPIO_ACTIVE_LOW>;
		startup-delay-us = <10000>;
	};

	sata0_supply: regulator-sata0 {
		compatible = "regulator-fixed";
		regulator-name = "sata0-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&gpio 56 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&sata0_power_pins>;
	};

	sata1_supply: regulator-sata1 {
		compatible = "regulator-fixed";
		regulator-name = "sata1-5v";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpios = <&iso_gpio 15 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <100000>;
		pinctrl-names = "default";
		pinctrl-0 = <&sata1_power_pins>;
	};
};

&{/reserved-memory} {
	/delete-node/ rpc@1f000;
	/delete-node/ rpc@1ffe000;
	/delete-node/ tee@10100000;

	bl31@10000000 {
		reg = <0x10000000 0x40000>;
		no-map;
	};
};

&cpu0 { enable-method = "psci"; };
&cpu1 { enable-method = "psci"; };
&cpu2 { enable-method = "psci"; };
&cpu3 { enable-method = "psci"; };

&pinctrl {
	pcie0_reset_pins: pcie0-reset-pins {
		pinctrl-single,bits = <0xc 0 0xc0000000>;
	};

	pcie1_reset_pins: pcie1-reset-pins {
		pinctrl-single,bits = <0xc 0 0x03000000>;
	};

	fan_pins: fan-pins {
		pinctrl-single,bits = <0xc 0 0x00030000>;
	};
};

&pcie0 {
	status = "okay";
	reset-gpios = <&gpio 16 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_reset_pins>;
};

&pcie1 {
	status = "okay";
	reset-gpios = <&gpio 19 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_reset_pins>;
};

&sfc {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <25000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "atf";
				reg = <0 0x40000>;
				read-only;
			};

			partition@40000 {
				label = "uboot_a";
				reg = <0x40000 0x400000>;
			};

			partition@440000 {
				label = "uboot_b";
				reg = <0x440000 0x400000>;
			};

			partition@840000 {
				label = "ubi_env";
				reg = <0x840000 0x7c0000>;
			};
		};
	};
};

&uart0 {
	status = "okay";
};

&gmac {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac_led_pins>;
	u-boot,link-led = <&link_led>;
	u-boot,activity-led = <&activity_led>;
};

&iso_pinctrl {
	sata1_power_pins: sata1-power-pins {
		pinctrl-single,bits = <0 0 0x00300000>;
	};

	gmac_led_pins: gmac-led-pins {
		pinctrl-single,bits = <4 0 0x00330000>;
	};
};

&disp_pinctrl {
	sata0_power_pins: sata0-power-pins {
		pinctrl-single,bits = <8 0 0x30>;
	};
};

&sata_phy {
	status = "okay";
};

&sata {
	status = "okay";

	sata-port@0 {
		reg = <0>;
		phys = <&sata_phy 0>;
		target-supply = <&sata0_supply>;
	};

	sata-port@1 {
		reg = <1>;
		phys = <&sata_phy 1>;
		target-supply = <&sata1_supply>;
	};
};

&emmc {
	status = "okay";
	bus-width = <8>;
	max-frequency = <20000000>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_pins>;
};

&cr_pinctrl {
	sd_pins: sd-pins {
		pinctrl-single,bits =
			<0x04 0x55550000 0xffff0000>,
			<0x10 0x33333323 0x33333333>,
			<0x34 0x00003333 0x0000ffff>,
			<0x38 0x33333333 0xffffffff>;
	};

	emmc_pins: emmc-pins {
		pinctrl-single,bits =
			<0x00 0xaaaa0828 0xffff0c3c>,
			<0x0c 0x33333333 0x33333333>,
			<0x24 0x77777777 0x77777777>,
			<0x28 0x77777777 0x77777777>,
			<0x2c 0x77007700 0x77007700>;
	};
};

&sd {
	status = "okay";
	bus-width = <4>;
	max-frequency = <25000000>;
	no-1-8-v;
	vmmc-supply = <&sd_supply>;
	pinctrl-names = "default";
	pinctrl-0 = <&sd_pins>;
};
