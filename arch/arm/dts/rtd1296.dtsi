#include <arm64/realtek/rtd1296.dtsi>

/ {
	emmc_input: clock-emmc {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <80000000>;
	};
};

&rbus {
	cr_domain: power-domain-cr {
		compatible = "realtek,rtd1296-reset-domain";
		#power-domain-cells = <1>;
		resets = <&reset2 10>;
		reset-names = "domain";
	};

	sd: mmc@10400 {
		compatible = "realtek,rtd1296-sdmmc";
		reg = <0x10400 0x200>;
		realtek,crt = <&crt>;
		realtek,sb2 = <&sb2>;
		clocks = <&crt_gates 25>, <&crt_gates 31>;
		power-domains = <&cr_domain 0>;
		status = "disabled";
	};

	emmc: mmc@12000 {
		compatible = "realtek,rtd1296-dw-mshc";
		reg = <0x12000 0x600>;
		realtek,crt = <&crt>;
		clocks = <&emmc_input>, <&crt_gates 24>,
			 <&crt_gates 25>, <&crt_gates 28>;
		clock-names = "ciu", "card", "biu", "ip";
		resets = <&reset2 11>;
		reset-names = "emmc";
		power-domains = <&cr_domain 0>;
		status = "disabled";
	};

	cr_pinctrl: pinctrl@12600 {
		compatible = "pinctrl-single";
		reg = <0x12600 0x40>;
		#pinctrl-cells = <1>;
		pinctrl-single,register-width = <32>;
		pinctrl-single,function-mask = <3>;
		pinctrl-single,bit-per-mux;
	};
};

&crt {
	crt_gates: clock-controller@c {
		compatible = "realtek,rtd1296-clk-gates";
		reg = <0xc 8>;
		#clock-cells = <1>;
	};
};


&misc {
	gpio: gpio@100 {
		compatible = "realtek,rtd1296-gpio";
		reg = <0x100 0x30>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&iso {
	iso_pinctrl: pinctrl@310 {
		compatible = "pinctrl-single";
		reg = <0x310 0x10>;
		#pinctrl-cells = <1>;
		pinctrl-single,register-width = <32>;
		pinctrl-single,function-mask = <3>;
		pinctrl-single,bit-per-mux;
	};

	iso_gates: clock-controller@8c {
		compatible = "realtek,rtd1296-clk-gates";
		reg = <0x8c 4>;
		#clock-cells = <1>;
	};

	iso_gpio: gpio@100 {
		compatible = "realtek,rtd1296-iso-gpio";
		reg = <0x100 0x24>;
		gpio-controller;
		#gpio-cells = <2>;
	};
};

&sb2 {
	pinctrl: pinctrl@900 {
		compatible = "pinctrl-single";
		reg = <0x900 0x10>;
		#pinctrl-cells = <1>;
		pinctrl-single,register-width = <32>;
		pinctrl-single,function-mask = <3>;
		pinctrl-single,bit-per-mux;
	};
};

&{/soc@0} {
	usb_bus: usb-bus {
		compatible = "realtek,rtd1296-usb-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		clocks = <&crt_gates 4>;
		power-domains = <&serdes_domain 0>;
		resets = <&reset1 8>, <&reset1 9>, <&reset2 3>,
			 <&reset1 2>, <&reset2 2>, <&reset2 4>,
			 <&reset1 6>, <&reset1 4>, <&reset2 5>;
		reset-names = "usb2-0", "usb2-1", "usb2-2", "usb3-0",
			      "usb2-3", "usb3-1", "controller", "mdio0", "mdio1";
		status = "disabled";

		typec_usb3_phy: phy@98013210 {
			compatible = "realtek,rtd1296-usb3phy";
			reg = <0x98013210 4>;
			#phy-cells = <0>;
		};

		typec_usb2_phy: phy@98013214 {
			compatible = "realtek,rtd1296-usb2phy";
			reg = <0x98013214 4>, <0x98028280 4>;
			#phy-cells = <0>;
		};

		typec: typec@9801334c {
			compatible = "realtek,rtd1296-typec-source";
			reg = <0x9801334c 0x18>;
		};

		usb3_phy: phy@98013e10 {
			compatible = "realtek,rtd1296-usb3phy";
			reg = <0x98013e10 4>;
			#phy-cells = <0>;
		};

		usb3_usb2_phy: phy@98013e14 {
			compatible = "realtek,rtd1296-usb2phy";
			reg = <0x98013e14 4>, <0x981f8280 4>;
			#phy-cells = <0>;
		};

		ehci: usb@98013000 {
			compatible = "realtek,rtd1296-ehci";
			reg = <0x98013000 0x100>, <0x98013800 0x50>;
			reg-names = "core", "wrapper";
		};

		typec_host: usb@98020000 {
			compatible = "realtek,rtd1296-dwc3";
			reg = <0x98020000 0x9000>, <0x98013200 0x140>;
			reg-names = "core", "wrapper";
			dr_mode = "host";
			maximum-speed = "super-speed";
			phys = <&typec_usb3_phy>, <&typec_usb2_phy>;
			phy-names = "usb3-phy", "usb2-phy";
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
		};

		usb2_host: usb@98029000 {
			compatible = "realtek,rtd1296-dwc3";
			reg = <0x98029000 0x9000>, <0x98013c00 0x140>;
			reg-names = "core", "wrapper";
			dr_mode = "host";
			maximum-speed = "high-speed";
			snps,dis_u2_susphy_quirk;
		};

		usb3_host: usb@981f0000 {
			compatible = "realtek,rtd1296-dwc3";
			reg = <0x981f0000 0x9000>, <0x98013e00 0x140>;
			reg-names = "core", "wrapper";
			dr_mode = "host";
			maximum-speed = "super-speed";
			phys = <&usb3_phy>, <&usb3_usb2_phy>;
			phy-names = "usb3-phy", "usb2-phy";
			snps,dis_u2_susphy_quirk;
			snps,dis_u3_susphy_quirk;
		};
	};

	pcie_sds: syscon@9801c600 {
		compatible = "syscon";
		reg = <0x9801c600 0x100>;
	};

	pcie0: pcie@9804e000 {
		compatible = "realtek,rtd1296-pcie-gen1";
		reg = <0x9804e000 0x1000>, <0x9804f000 0x800>;
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <0 0>;
		ranges = <0x02000000 0 0xc0000000 0x9804f000 0 0x800>;
		realtek,sds = <&pcie_sds>;
		realtek,sb2 = <&sb2>;
		power-domains = <&serdes_domain 0>;
		clocks = <&crt_gates 1>;
		resets = <&reset2 6>, <&reset2 8>, <&reset2 13>,
			 <&reset2 14>, <&reset2 15>, <&reset2 7>, <&reset4 13>;
		status = "disabled";
	};

	pcie1: pcie@9803b000 {
		compatible = "realtek,rtd1296-pcie-gen2";
		reg = <0x9803b000 0x1000>, <0x9803c000 0x800>;
		device_type = "pci";
		#address-cells = <3>;
		#size-cells = <2>;
		bus-range = <1 1>;
		ranges = <0x02000000 0 0xc1000000 0x9803c000 0 0x800>;
		realtek,sds = <&pcie_sds>;
		realtek,sb2 = <&sb2>;
		power-domains = <&serdes_domain 0>;
		clocks = <&crt_gates 37>;
		resets = <&reset2 19>, <&reset2 17>, <&reset2 20>,
			 <&reset2 21>, <&reset2 22>, <&reset2 16>, <&reset4 14>;
		status = "disabled";
	};

	serdes_domain: power-domain-serdes {
		compatible = "realtek,rtd1296-reset-domain";
		#power-domain-cells = <1>;
		resets = <&reset2 31>;
		reset-names = "domain";
	};

	sata_phy: phy@9803ff60 {
		compatible = "realtek,rtd1296-sata-phy";
		reg = <0x9803ff60 0x10>;
		#phy-cells = <1>;
		realtek,sb2 = <&sb2>;
		power-domains = <&serdes_domain 0>;
		clocks = <&crt_gates 7>, <&crt_gates 58>;
		resets = <&reset1 10>, <&reset4 7>;
		reset-names = "port0", "port1";
		status = "disabled";
	};

	sata: sata@9803f000 {
		compatible = "realtek,rtd1296-ahci";
		reg = <0x9803f000 0x200>;
		power-domains = <&serdes_domain 0>;
		clocks = <&crt_gates 2>, <&crt_gates 57>;
		resets = <&reset1 5>, <&reset1 7>, <&reset4 10>, <&reset4 9>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};

	disp_pinctrl: pinctrl@9804d000 {
		compatible = "pinctrl-single";
		reg = <0x9804d000 0x10>;
		#pinctrl-cells = <1>;
		pinctrl-single,register-width = <32>;
		pinctrl-single,function-mask = <3>;
		pinctrl-single,bit-per-mux;
	};

	gmac: ethernet@98016000 {
		compatible = "realtek,rtd1296-gmac";
		reg = <0x98016000 0x1000>;
		realtek,iso = <&iso>;
		clocks = <&iso_gates 11>, <&iso_gates 12>;
		clock-names = "250m", "sys";
		resets = <&iso_reset 9>, <&iso_reset 10>;
		reset-names = "gmac", "gphy";
		phy-mode = "internal";
		status = "disabled";
	};

	sfc: spi@9801a800 {
		compatible = "realtek,rtd1296-sfc";
		reg = <0x9801a800 0x30>, <0x88100000 0x1000000>;
		reg-names = "ctrl", "flash";
		realtek,sb2 = <&sb2>;
		#address-cells = <1>;
		#size-cells = <0>;
		status = "disabled";
	};
};
